{
  "name": "admin-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node scripts/database.js migrate",
    "db:seed": "node scripts/database.js seed",
    "db:setup": "node scripts/database.js setup",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "predev": "node scripts/check-env.js",
    "prestart": "node scripts/check-env.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.18",
    "@inquirer/prompts": "8.7.4",
    "bcryptjs": "3.0.3",
    "big.js": "7.0.1",
    "dotenv": "18.0.8",
    "iron-session": "9.0.1",
    "lodash": "4.18.1",
    "mysql2": "3.24.6",
    "next": "16.4.2",
    "rate-limiter-flexible": "11.2.3",
    "raw-body": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sequelize": "6.37.8",
    "swr": "2.5.1",
    "umzug": "3.8.3",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
