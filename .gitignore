# dependencies
**/node_modules/
tools/frida/.build/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
**objc-info.txt
# testing
/coverage
/.database-backups/

