# Copy to .env.test.local. Never point this file at a business database.
# Create and grant access to this dedicated database before running tests.
# Literal dollar signs stay as $ here; do not escape them as \$.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_starter_test
DB_USER=admin_starter
DB_PASSWORD=admin_starter
DB_POOL_MAX=10

# Used only to seed and log into the dedicated test database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test-admin-password

# The runner generates SESSION_SECRET, the build directory and the server URL.
# Do not add TEST_BASE_URL or copy values from .env.local.
