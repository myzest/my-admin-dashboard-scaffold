# Next.js parsing: escape literal dollar signs as \$ in this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_starter
DB_USER=admin_starter
DB_PASSWORD=
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Empty for direct access. For a local Nginx proxy: 127.0.0.1,::1
# The trusted proxy must overwrite X-Forwarded-For with one client IP.
TRUSTED_PROXY_IPS=

# Used only by db:seed / db:setup. No built-in default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
